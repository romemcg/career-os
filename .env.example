# CareerOS configuration. Copy to .env and adjust. Never commit .env.

# PostgreSQL connection (local only).
DATABASE_URL="postgresql://careeros:CHANGE_ME@127.0.0.1:5432/careeros"

# Port and bind address. CareerOS binds to 127.0.0.1 only. 3001 avoids Life OS on 3000.
PORT=3001

# Private data directory for documents, generated files, backups and logs.
# Defaults to ~/Library/Application Support/CareerOS on macOS and
# ~/.local/share/careeros elsewhere when unset.
# CAREEROS_DATA_DIR=

# Session lifetime in hours (default 12).
SESSION_TTL_HOURS=12

# Maximum upload size in megabytes (default 20).
MAX_UPLOAD_MB=20

# Separate database used by integration and end-to-end tests. Its contents are deleted by the tests.
TEST_DATABASE_URL="postgresql://careeros:CHANGE_ME@127.0.0.1:5432/careeros_test"
